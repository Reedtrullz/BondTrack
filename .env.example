# Heimdall environment example.
# Copy to .env.local for local overrides. Do not commit real secrets.

# Public variables are bundled into browser JavaScript during build. Never put
# secrets here. Runtime changes to these names do not rewrite an already-built
# client bundle; rebuild the Docker image when public endpoints change.
NEXT_PUBLIC_THORNODE_API=https://gateway.liquify.com/chain/thorchain_api
NEXT_PUBLIC_MIDGARD_API=https://gateway.liquify.com/chain/thorchain_midgard
NEXT_PUBLIC_THORCHAIN_RPC=https://gateway.liquify.com/chain/thorchain_rpc
NEXT_PUBLIC_TRACK_API=https://track.thorchain.org/
NEXT_PUBLIC_MIDGARD_FALLBACK=https://midgard.thorchain.network
NEXT_PUBLIC_COINGECKO_API=https://api.coingecko.com/api/v3
NEXT_PUBLIC_THORCHAIN_NETWORK=mainnet
# Production builds set this to https://bond.thorchain.no.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK_DATA=false

# Server-side proxy endpoints. These are read only on the server/runtime side.
THORNODE_API_URL=https://gateway.liquify.com/chain/thorchain_api/thorchain
MIDGARD_API_URL=https://gateway.liquify.com/chain/thorchain_midgard
MIDGARD_FALLBACK_URL=https://midgard.thorchain.network

# Runtime identity and server binding. Ansible sets VERSION to the immutable
# deployed image tag, for example sha-490cac0.
VERSION=local
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Optional server-side secret for historical RUNE price lookups. Leave blank in
# examples and local files unless you have a real key.
COINAPI_KEY=
